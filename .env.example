# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Groq AI (free key: https://console.groq.com/keys) — powers AI Coach chat,
# speaking feedback and other AI features via lib/ai.ts
GROQ_API_KEY=gsk_...
# Optional: override the default Groq model
GROQ_MODEL=

# Google OAuth (optional; falls back to the hardcoded client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
