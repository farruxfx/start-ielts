# ═══════════════════════════════════════════════════════════════════
#  STARTIELTS — Monetization / Access Control environment variables
#  Copy to .env.local and fill in. NEVER commit real secrets.
# ═══════════════════════════════════════════════════════════════════

# ─── Signed session cookie (premium access control) ─────────────────
# ECDSA P-256 asymmetric keypair. The SERVER signs the session cookie
# with the PRIVATE key (Node runtime API routes); the Edge middleware
# verifies it with the PUBLIC key (safe to expose — cannot forge).
#
# Generate a real production pair:
#   node -e "const {generateKeyPairSync}=require('crypto');#   const {publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});#   const exp=(k)=>JSON.stringify(k.export({format:'jwk'}));#   console.log('SESSION_PRIVATE_JWK='+exp(privateKey));#   console.log('NEXT_PUBLIC_SESSION_PUBLIC_JWK='+exp(publicKey));"
#
# SESSION_PRIVATE_JWK = {"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# NEXT_PUBLIC_SESSION_PUBLIC_JWK = {"kty":"EC","crv":"P-256","x":"...","y":"..."}
#
# If unset in development a hardcoded DEV keypair is used (fine locally,
# NEVER rely on it in production — Vercel env MUST set both variables).

# ─── Manual premium grant (no-database demo/admin mode) ─────────────
# Grants a specific user a premium subscription without any payment row.
# Leave empty in production.
# ADMIN_GRANT_USER_ID=
# ADMIN_GRANT_PLAN=pro
# ADMIN_GRANT_DAYS=30

# ─── Supabase (existing config — shown for completeness) ────────────
# Premium truth: user_subscriptions + payment_orders tables.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
